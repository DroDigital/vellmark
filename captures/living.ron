        (name: "wall_25cm", from: (eye: (1.9, 1.68, -5.75), yaw: 0.0, pitch: 0.0), hour: 15.0, look: 4),
        (name: "wall_oblique", from: (eye: (2.6, 1.68, -5.55), yaw: 48.0, pitch: -4.0), hour: 15.0, look: 4),
        (name: "door", from: (eye: (0.35, 1.25, -5.6), yaw: -8.0, pitch: -4.0), hour: 15.0, look: 4),
        (name: "ledger", from: (eye: (0.75, 2.05, -5.25), yaw: 0.0, pitch: 0.0), hour: 15.0, look: 4),
