        (name: "atoms_ledger", from: (eye: (0.75, 2.05, -5.25), yaw: 0.0, pitch: 0.0), hour: 15.0, look: 1, pair: true, crop: (480, 270, 960, 540)),
        (name: "lattice_2m", from: (eye: (1.9, 1.68, -4.0), yaw: 0.0, pitch: 0.0), hour: 15.0, look: 2, pair: true, crop: (480, 270, 960, 540)),
        (name: "lattice_60cm", from: (eye: (1.9, 1.68, -5.4), yaw: 0.0, pitch: 0.0), hour: 15.0, look: 2, pair: true, crop: (480, 270, 960, 540)),
        (name: "lattice_oblique", from: (eye: (2.6, 1.68, -5.55), yaw: 48.0, pitch: -4.0), hour: 15.0, look: 2, pair: true, crop: (480, 270, 960, 540)),
