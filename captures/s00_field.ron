// The Phase S00 test field. It proves the capture tool, the reference images, and the
// shimmer check before there is a renderer to judge with them.
#![enable(implicit_some)]
(
    name: "s00_field",
    width: 480,
    height: 270,
    shots: [
        (name: "noon", from: (eye: (0.0, 1.68, 0.0), yaw: 20.0, pitch: -6.0), hour: 12.0, pair: true, reference: true),
        (name: "dusk", from: (eye: (0.0, 1.68, 0.0), yaw: 265.0, pitch: 4.0), hour: 17.6, reference: true),
        (name: "night", from: (eye: (0.0, 1.68, 0.0), yaw: 20.0, pitch: 10.0), hour: 1.0, reference: true),
        (name: "high", from: (eye: (0.0, 40.0, 0.0), yaw: 45.0, pitch: -35.0), hour: 9.0, reference: true),
        (
            name: "shimmer_far_field",
            from: (eye: (0.0, 1.68, 0.0), yaw: 0.0, pitch: -3.0),
            // The move must be slow: a small part of a pixel each frame, so that all the
            // change the check sees is change that should not be there.
            to: (eye: (0.03, 1.68, 0.0), yaw: 0.0, pitch: -3.0),
            hour: 12.0,
            frames: 24,
            shimmer: true,
        ),
    ],
)
