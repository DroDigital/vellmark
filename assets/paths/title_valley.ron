// The title's camera over the valley at dawn. Nothing of it shows until the ink thins
// (about 12 s in); then the valley is seen from high over Tithe Hill, looking north over
// the barley to the river, and the camera sinks slowly to where the player stands by the
// time the title is up (24 s), so that the game begins where the title leaves off: the
// ground there is at 48.7 m, and the eye stands 1.68 m above it.
(
    keys: [
        (eye: (-112.0, 78.0, 150.0), yaw: 20.0, pitch: -12.0, hour: 5.7, seconds: 14.0),
        (eye: (-110.0, 72.0, 143.0), yaw: 20.0, pitch: -11.0, hour: 5.85, seconds: 10.0),
        (eye: (-104.0, 50.4, 112.0), yaw: 20.0, pitch: -6.0, hour: 6.3),
    ],
)
