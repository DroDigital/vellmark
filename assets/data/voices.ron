        "B7": (pitch: 185.0, size: 1.04, rate: 4.4, breath: 0.05, gravel: 0.05), // The Bell
        "B8": (pitch: 145.0, size: 0.98, rate: 5.4, breath: 0.1, gravel: 0.05), // The Nib
        "B9": (pitch: 82.0, size: 0.86, rate: 3.2, breath: 0.08, gravel: 0.25), // The Ox
        "B10": (pitch: 150.0, size: 1.0, rate: 4.4, breath: 0.05, gravel: 0.0), // The Fair Copy
    },
