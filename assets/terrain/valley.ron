// The Showcase's ground: Tithe Hill to the south-west, the road down through the barley
// to Little Penance, the River Quill across the north of the area, the mill pond, and
// the far bank rising beyond it. Outside the 512 m area the same land runs on as the
// far ring: rolling country and woods, the highlands to the north, and the white band
// of the Erasure along the northern horizon.
//
// Metres. X runs east, Z runs south: north is -Z. Every feature has a key that is never
// renamed. Rivers and ponds find their own water levels from the ground, so moving one
// never floods a field.
#![enable(implicit_some)]
(
    seed: 4112,
    shape: (
        // The valley floor, and how it rises away from the river.
        floor: 4.0,
        from_river: 0.055,
        from_river_most: 16.0,
        relief: 2.6,
        wavelength: 240.0,
        rolling: (height: 46.0, wavelength: 1100.0, beyond: 560.0),
        highlands: (from: 1300.0, to: 4600.0, height: 330.0, wavelength: 700.0),
        forest: (beyond: 300.0, cover: 0.46, wavelength: 420.0),
        erasure: (from: 3500.0, ragged: 420.0),
    ),
    // Steep ground closes the area: nothing invisible stops the player.
    edges: (start: 226.0, width: 16.0, north: 9.0, south: 16.0, east: 14.0, west: 15.0),
    hills: [
        (key: "tithe_hill", centre: (-112.0, 128.0), radius: 150.0, height: 33.0),
        (key: "tithe_hill_shoulder", centre: (-190.0, 60.0), radius: 90.0, height: 12.0),
        (key: "far_bank_rise", centre: (150.0, -235.0), radius: 140.0, height: 7.0),
    ],
