        (key: "penance_green_trodden", centre: (42.0, -38.0), radius: 7.0, blend: 6.0, ground: Earth),
        (key: "mill_yard", centre: (82.0, -84.0), radius: 12.0, blend: 14.0, ground: Earth),
        (key: "quiet_orchard", centre: (150.0, -178.0), radius: 26.0, blend: 22.0),
