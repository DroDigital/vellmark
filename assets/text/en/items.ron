// Things that can be found, carried, and sold: their names, made of parts. A name states
// what an item carries: a maker for a bonus ("Tally's"), the material, the type, a clause
// as its suffix ("of Prior Claim"), and a word clause after a comma. Keys are permanent.
{
    "item.name": "{maker}{material} {type}{clause}{word_clause}",
    "item.maker.tally": "Tally's ",
    "item.maker.rook": "Rook's ",
    "item.maker.pell": "Pell's ",
    "item.maker.ashby": "Ashby's ",
    "item.maker.marrow": "Marrow's ",
