// Words of the interface: prompts' verbs and the like. Keys are permanent: add, never
// rename.
{
    "ui.read": "Read",
    "ui.crosshair": "+",
    "ui.sealed": "It is sealed.",
    "ui.ring.full": "o",
    "ui.ring.empty": ".",
    "ui.ink.stroke": "|",
    "ui.health.stroke": "|",
    "ui.stamina.stroke": "|",
    "ui.arrow.stroke": "^",
    // From the prologue's script, when the Tithe Hill Stone gives up its word.
    // Creatures, by species and annotation, as the crosshair names them.
    "creature.inkling": "Inkling",
    "creature.inkling.locked": "Locked Inkling",
    "creature.inkling.dark": "Dark Inkling",
    "creature.inkling.burning": "Burning Inkling",
    "creature.inkling.cold": "Cold Inkling",
    "ui.learned": "You have learned a word. It is not yours. Nothing here is.",
    // The interface kit: the rule round a panel, the focus mark, and the held mark.
    "ui.rule.across": "-",
    "ui.rule.down": "|",
    "ui.rule.corner": "+",
    "ui.focus": ">",
    "ui.held": "*",
    "ui.ellipsis": "...",
    // The inventory.
    "ui.inventory.title": "Pack",
    "ui.inventory.marks": "{n} Marks",
    "ui.inventory.empty": "Nothing carried.",
    "ui.inventory.equip": "{key} Equip",
    "ui.inventory.close": "{key} Close",
    "ui.inventory.held": "Equipped",
    "ui.inventory.tier_held": "{tier}, {held}",
    "ui.inventory.weight": "Carrying {n}",
}
