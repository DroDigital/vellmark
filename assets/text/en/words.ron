    "refuse.calm.structure": "The bridge is calm. It is a bridge.",
    "refuse.calm.weapon": "The blade has no temper to lose.",
    "refuse.clam.fire": "The fire mutters on.",
    "refuse.clam.lamp": "The lantern has nothing to say.",
