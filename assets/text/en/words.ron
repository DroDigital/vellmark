    "refuse.burning.person": "Not here. The Vale remembers who starts fires.",
    "refuse.calm.container": "The chest keeps its feelings to itself.",
    "refuse.calm.door": "The door was never upset.",
    "refuse.calm.held_weapon": "A calm blade cuts nothing.",
    "refuse.calm.lamp": "The flame does not hear you.",
    "refuse.calm.paper": "The page is unmoved.",
    "refuse.calm.plant": "The hedge is as calm as hedges get.",
