// The valley of Phase S02: the Showcase's ground and nothing on it yet. A visitor
// starts on Tithe Hill, by the top, looking north down over the barley to the river
// and the far bank. The village, the graves, and everything else come in S06.
#![enable(implicit_some)]
(
    terrain: "valley",
    spawn: (eye: (-104.0, 40.0, 112.0), yaw: 20.0, pitch: -6.0),
    objects: [
        // The Mended Bridge: timber planks on two stringers, posts and rails, and two
        // masonry piers into the bed of the Quill. Its deck runs from the bridge road on
        // the south bank to the far bank's track. It lies broken until `WHOLE` is written
        // on it; then it knits back from the writer's end, and each piece bears weight
        // as soon as its letters are home.
        (
            key: "mended_bridge",
            position: (132.25, 4.35, -113.25),
            yaw: 173.19,
            // Drawn a piece to each box, so that WHOLE puts it back a piece at a time.
            pieces: true,
            boxes: [
                (material: "timber", min: (-1.1, -0.12, -12.20), max: (1.1, 0.0, -10.20)),
                (material: "timber", min: (-1.1, -0.12, -10.17), max: (1.1, 0.0, -8.17)),
                (material: "timber", min: (-1.1, -0.12, -8.13), max: (1.1, 0.0, -6.13)),
